VITE_API_URL=http://localhost:4000

# --- Connexion avec Google (gestionnaires uniquement) ---
# Client ID OAuth 2.0 (public, jamais le Client Secret) créé dans la Google
# Cloud Console (identifiant se terminant par .apps.googleusercontent.com).
# Laissez vide pour masquer entièrement le bouton "Se connecter avec Google"
# sur les pages de connexion et d'inscription. Doit correspondre à
# GOOGLE_CLIENT_ID côté backend.
VITE_GOOGLE_CLIENT_ID=

# --- Suivi des erreurs (Sentry) ---
# DSN du projet Sentry (frontend — distinct de celui du backend). Laissez
# vide pour désactiver Sentry entièrement (aucune donnée envoyée) — utile en
# local/dev.
VITE_SENTRY_DSN=

# --- Mesure d'audience et publicité (chargés uniquement après consentement
# explicite du visiteur via le bandeau cookies, voir CookieConsentBanner.tsx)
# ---
# ID de mesure Google Analytics 4, format G-XXXXXXXXXX. Laissez vide pour
# désactiver GA4 et masquer le bandeau cookies si les deux autres variables
# ci-dessous sont également vides.
VITE_GA_MEASUREMENT_ID=
# ID du pixel Meta (Facebook/Instagram), numérique. Laissez vide pour
# désactiver le pixel.
VITE_META_PIXEL_ID=
# ID de partenaire LinkedIn Insight Tag, numérique. Laissez vide pour
# désactiver le tag.
VITE_LINKEDIN_PARTNER_ID=
