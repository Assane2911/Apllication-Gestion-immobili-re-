# Dépendances
node_modules/

# Builds
dist/
build/
*.tsbuildinfo

# Rapports de couverture de tests (générés localement/en CI, non versionnés)
coverage/

# Variables d'environnement (secrets) : toutes les variantes (.env.production, .env.vercel de `vercel env pull`,
# .env.*.local…), sauf les modèles `.env.example` qui, eux, sont versionnés.
.env
.env.*
!.env.example

# Clés et certificats : signature Android (keystore), clés privées, certificats avec clé.
*.keystore
*.jks
keystore.properties
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

# Logs
npm-debug.log*
*.log

# Sorties des campagnes de tests lancees en local
# (npm test > ..\test-output.txt) : utiles sur le moment pour relire le
# detail d'un run, mais propres a une machine et sans interet dans l'historique.
test-output*.txt

# Éditeurs / OS
.DS_Store
.vscode/
.idea/

# Drizzle (migrations générées, non nécessaires avec le mode "push")
backend/drizzle/

# Base de données locale temporaire
backend/data/


# Config locale d'un outil AI tiers (non liee au projet)
.snapshots/

# Rapports de simulation de charge (générés par backend/scripts/charge/simuler.js)
backend/scripts/charge/rapports/
