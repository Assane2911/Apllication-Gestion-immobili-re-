META_WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" du numÃ©ro WhatsApp Business expÃ©diteur (WhatsApp Manager
# â†’ le numÃ©ro â†’ Phone number ID) â€” PAS le numÃ©ro de tÃ©lÃ©phone lui-mÃªme.
META_WHATSAPP_PHONE_NUMBER_ID=

# Noms des modÃ¨les de message ("Message Templates") crÃ©Ã©s et approuvÃ©s dans
