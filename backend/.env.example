# --- Serveur ---
PORT=4000
NODE_ENV=development
# URL du frontend déployé (Vercel) — utilisée pour l'autorisation CORS.
FRONTEND_URL=http://localhost:5173
# URL publique de CE backend une fois déployé — nécessaire pour construire le
# callback_url envoyé aux prestataires de paiement externes (PayDunya...).
# Sur Vercel, laissez vide : VERCEL_PROJECT_PRODUCTION_URL est injecté automatiquement.
PUBLIC_BACKEND_URL=

# --- Base de données : Postgres Supabase ---
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Ce mode (Supavisor, transaction) est celui recommandé pour les environnements
# serverless comme Vercel : connexions courtes et nombreuses.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres"
# Délais, en millisecondes, au-delà desquels une requête isolée (défaut : 15000) ou une transaction (défaut : 120000)
# est tenue pour bloquée et la connexion recréée. À ne changer qu'en cas de besoin constaté.
# DB_DELAI_REQUETE_MS=15000
# DB_DELAI_TRANSACTION_MS=120000

# --- Données de démonstration (npm run seed, développement uniquement) ---
# Le seed refuse de tourner en production, et sur toute base qui n'est pas locale (donc sur un projet Supabase) tant que
# ceci n'est pas explicitement « true ».
# SEED_ALLOW_REMOTE=true
# Mot de passe des comptes de démonstration. Sans cette variable, un mot de passe ALÉATOIRE est généré et affiché une
# seule fois à la fin du seed.
# SEED_PASSWORD=

# --- Supabase (Storage + accès admin) ---
# Supabase → Project Settings → API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé "service_role" — À NE JAMAIS exposer côté frontend, uniquement utilisée par ce backend.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Noms des buckets Supabase Storage à créer (voir README) — valeurs par défaut ci-dessous.
SUPABASE_PUBLIC_BUCKET=public-uploads
SUPABASE_PRIVATE_BUCKET=private-uploads

# --- Authentification ---
JWT_SECRET=changez-cette-cle-secrete-en-production
JWT_EXPIRES_IN=7d

# --- Connexion avec Google (gestionnaires uniquement) ---
# Client ID OAuth 2.0 créé dans la Google Cloud Console (type "Application
# Web", identifiant se terminant par .apps.googleusercontent.com). Aucun
# Client Secret requis : la vérification du jeton Google se fait uniquement
# avec ce Client ID (voir auth.controller.ts::loginWithGoogle). Laissez vide
# pour désactiver la route et masquer le bouton côté frontend (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# --- E-mail (SMTP) : rappels, quittances, confirmations d'adresse, invitations... ---
# L'adresse d'expéditeur (EMAIL_FROM) doit être celle d'un domaine dont le serveur d'envoi est AUTORISÉ dans le DNS
# (SPF) et signe les messages (DKIM) : sinon les messages arrivent en courrier indésirable, voire ne partent pas.
# Gmail ne signe qu'au nom de gmail.com : il convient pour un essai en local, pas pour un expéditeur en
# @votre-domaine. Pour un domaine à soi, utilisez le SMTP de l'hébergeur de la messagerie de ce domaine.
# Si l'envoi échoue, une alerte Sentry est émise (au plus une par cause et par dix minutes) ; voir DEPLOYMENT.md,
# « Délivrabilité des e-mails », pour vérifier SPF / DKIM / DMARC.
#
# Option A — Gmail (local / essai) :
#   1. Activez la validation en 2 étapes sur le compte Gmail
#   2. Générez un "mot de passe d'application" sur https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre-adresse@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM="Gestion Immobilière <votre-adresse@gmail.com>"
#
# Option B — domaine à soi, messagerie Zoho (production) : remplacez les cinq lignes ci-dessus par
#   SMTP_HOST=smtp.zoho.com        (smtp.zoho.eu si le compte Zoho est européen)
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=contact@votre-domaine.com
#   SMTP_APP_PASSWORD=<mot de passe d'application Zoho, pas le mot de passe du compte>
#   EMAIL_FROM="ImmoPlatform Pro <contact@votre-domaine.com>"   (même adresse que SMTP_USER)

# Nombre de jours avant la fin du contrat pour envoyer le rappel
CONTRACT_REMINDER_DAYS=14
# Jours avant l'échéance d'un loyer pour le rappel « dernière minute » au locataire (défaut : 3)
# RENT_DUE_SOON_DAYS=3
# Jours avant l'échéance d'une police d'assurance pour prévenir le gestionnaire (défaut : 30)
# INSURANCE_REMINDER_DAYS=30

# --- Tâche planifiée (rappels de fin de contrat) ---
# En local (npm run dev) : un scheduler node-cron interne tourne automatiquement.
# Expression cron utilisée par ce scheduler local uniquement (par défaut: tous les jours à 8h00).
REMINDER_CRON="0 8 * * *"
# Mettez à "false" en production sur Vercel : ce sont les Vercel Cron Jobs (voir vercel.json)
# qui appellent /api/cron/daily et /api/cron/rent-due-reminders, à la place d'un processus
# interne permanent.
ENABLE_INTERNAL_CRON=true
# Doit être identique à la variable d'environnement CRON_SECRET définie sur le projet Vercel
# (Vercel l'envoie automatiquement en en-tête Authorization lors de l'appel du Cron Job).
CRON_SECRET=
# Temps qu'une route cron s'autorise avant de s'arrêter d'elle-même (secondes). Vercel tue
# une fonction au-delà de sa durée maximale (300 s par défaut) ; en s'arrêtant avant, la
# tâche laisse son reliquat non réclamé et l'exécution suivante le reprend. À augmenter
# seulement de pair avec un maxDuration relevé dans vercel.json.
CRON_BUDGET_SECONDS=240

# --- Paiements ---
# Stripe (carte bancaire) - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Devises que le paiement par carte accepte réellement (séparées par des
# virgules). Par défaut : EUR seul.
#
# Attention, tarifer une devise ne suffit pas pour l'encaisser : les formules
# sont tarifées dans les neuf devises du sélecteur (voir TARIFS dans
# subscription.controller.ts), mais toute devise absente de cette liste fait
# refuser le règlement par carte (503, voir payment.service.ts). Le
# gestionnaire voit alors le bon prix, mais ne peut régler que par virement
# bancaire — qui reste toujours proposé puisqu'il ne dépend d'aucun
# prestataire.
#
# N'ajoutez ici qu'une devise que votre compte Stripe accepte vraiment : une
# devise déclarée mais refusée par Stripe produit un échec au moment du
# paiement plutôt qu'un bouton simplement masqué. MAD, XAF et STN sont
# rarement encaissables par carte — pour celles-là, le virement est en
# pratique le seul moyen.
STRIPE_CURRENCIES=EUR,USD,GBP,CAD,CHF

# PayDunya (Orange Money, Wave, Free Money, MTN, carte bancaire...)
# https://app.paydunya.com/account/api-credentials (compte gratuit, sandbox inclus)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
# "test" = bac à sable PayDunya (aucun vrai paiement), "live" = production
PAYDUNYA_MODE=test
PAYDUNYA_STORE_NAME=ImmoPlatform Pro
# Devise du compte marchand PayDunya (défaut : XOF). L'API n'a aucun champ de devise : elle lit le montant dans la
# devise du compte, fixée par le pays du marchand. Cette valeur sert à refuser un paiement libellé dans une autre.
# PAYDUNYA_CURRENCY=XOF
# Nom affiché au payeur sur les pages Stripe ET PayDunya. Prime sur PAYDUNYA_STORE_NAME (défaut : « ImmoPlatform Pro »).
# PAYMENTS_STORE_NAME=ImmoPlatform Pro

# Mode démo : paiements simulés et confirmés instantanément, AUCUNE vraie transaction — pratique pour tester le
# flux en local. Valeur par défaut : « true » en local, « false » en production (NODE_ENV=production ou Vercel).
# En production, NE JAMAIS le mettre à « true » : un abonnement s'activerait sans qu'un centime ne soit encaissé,
# quel que soit le moyen de paiement choisi. Laissez donc cette ligne en commentaire (ou à « false ») sur Vercel.
# Le fichier est volontairement livré avec la ligne désactivée : le copier tel quel ne l'active pas.
# PAYMENTS_DEMO_MODE=true

# Stripe et PayDunya sont le compte de la plateforme : ils encaissent les ABONNEMENTS des agences. Laisser
# « false » : un locataire règle son loyer par virement vers le compte de son agence, et aucun loyer ne passe
# par la plateforme. Ne passer à « true » qu'avec un montage dédié (compte par agence) validé juridiquement.
RENT_ONLINE_PAYMENTS=false

# --- WhatsApp (API Meta WhatsApp Cloud, intégration directe) pour les rappels de loyer, en complément de l'email ---
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Tant que ces 2 valeurs ne sont pas renseignées, l'envoi retombe sur une
# simulation (comme l'email quand SMTP n'est pas configuré) : aucun message réel n'est envoyé.
# Jeton d'accès permanent d'un "System User" (Meta Business Manager → Business
# Settings → System Users → générer un jeton avec la permission
# whatsapp_business_messaging), PAS un jeton temporaire de test (expire en 24h).
META_WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" du numéro WhatsApp Business expéditeur (WhatsApp Manager
# → le numéro → Phone number ID) — PAS le numéro de téléphone lui-même.
META_WHATSAPP_PHONE_NUMBER_ID=

# Noms des modèles de message ("Message Templates") créés et approuvés dans
# le Meta WhatsApp Manager — OBLIGATOIRES : Meta refuse tout message envoyé à
# l'initiative de la plateforme (hors fenêtre de conversation de 24h) sans
# modèle pré-approuvé. Voir whatsapp.service.ts pour le texte exact et les
# variables attendues par chacun de ces 2 modèles.
META_WHATSAPP_TEMPLATE_RENT_DUE=
META_WHATSAPP_TEMPLATE_RENT_DUE_SOON=
# Avis d'échéance avec la vraie date limite (ex: "avis_echeance_loyer_date").
# Texte à faire approuver par Meta (6 variables, catégorie Utility, langue fr, sans en-tête ni bouton).
# Meta refuse un modèle qui commence ou se termine par une variable : le texte finit donc par une phrase.
#   Bonjour {{1}}, votre avis d'échéance de loyer pour {{2}} ({{3}}) est émis. Le montant à régler est
#   de {{4}}, au plus tard le {{5}}. Vous pouvez payer en ligne depuis votre espace locataire : {{6}}.
#   Merci de votre ponctualité.
# Exemples à saisir pour Meta : {{1}} Awa Sow · {{2}} octobre 2026 · {{3}} Appartement T3 Plateau ·
# {{4}} 250 000 FCFA · {{5}} 24 octobre 2026 · {{6}} https://votre-site/portail/paiements
# Une fois renseigné, il remplace META_WHATSAPP_TEMPLATE_RENT_DUE, dont le
# texte annonce « le 5 » en dur. Tant qu'il est vide, l'ancien modèle n'est
# envoyé que pour une facture réellement due le 5 du mois ; pour les autres,
# seul l'email (qui porte la bonne date) part.
META_WHATSAPP_TEMPLATE_RENT_DUE_DATED=
# Relance d'un loyer impayé (relances graduées, titulaire et colocataires). Texte à faire approuver
# par Meta (6 variables, catégorie Utility, langue fr, sans en-tête ni bouton), au ton volontairement
# neutre : Meta refuse un modèle qui menace de poursuites, ou qui commence/finit par une variable.
#   Bonjour {{1}}, sauf erreur de notre part, votre loyer de {{2}} ({{3}}) n'est pas encore réglé. Il
#   reste {{4}} à payer, l'échéance étant dépassée de {{5}} jour(s). Vous pouvez régler en ligne depuis
#   votre espace locataire : {{6}}. Si vous avez déjà payé, ne tenez pas compte de ce message.
# Exemples à saisir pour Meta : {{1}} Awa Sow · {{2}} octobre 2026 · {{3}} Appartement T3 Plateau ·
# {{4}} 250 000 FCFA · {{5}} 12 · {{6}} https://votre-site/portail/paiements
# Tant qu'il est vide, les relances partent par email seulement.
META_WHATSAPP_TEMPLATE_OVERDUE=
# Code langue déclaré pour ces modèles dans le WhatsApp Manager.
META_WHATSAPP_TEMPLATE_LANGUAGE=fr

# --- Suivi des erreurs (Sentry) ---
# DSN du projet Sentry (backend). Laissez vide pour désactiver Sentry
# entièrement (aucune donnée envoyée) — utile en local/dev.
SENTRY_DSN=
