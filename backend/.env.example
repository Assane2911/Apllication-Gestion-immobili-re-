# --- Base de donnÃ©es : Postgres Supabase ---
# Supabase â†’ Project Settings â†’ Database â†’ Connection string â†’ "Transaction pooler" (port 6543).
# Ce mode (Supavisor, transaction) est celui recommandÃ© pour les environnements
# serverless comme Vercel : connexions courtes et nombreuses.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:VOTRE_MOT_DE_PASSE@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres"

# --- Supabase (Storage + accÃ¨s admin) ---
# Supabase â†’ Project Settings â†’ API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ClÃ© "service_role" â€” Ã€ NE JAMAIS exposer cÃ´tÃ© frontend, uniquement utilisÃ©e par ce backend.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Noms des buckets Supabase Storage Ã  crÃ©er (voir README) â€” valeurs par dÃ©faut ci-dessous.
SUPABASE_PUBLIC_BUCKET=public-uploads
SUPABASE_PRIVATE_BUCKET=private-uploads

# --- Authentification ---
JWT_SECRET=changez-cette-cle-secrete-en-production
