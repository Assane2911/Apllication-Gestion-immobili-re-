# --- Serveur ---
PORT=4000
NODE_ENV=development
# URL du frontend dÃ©ployÃ© (Vercel) â€” utilisÃ©e pour l'autorisation CORS.
FRONTEND_URL=http://localhost:5173
# URL publique de CE backend une fois dÃ©ployÃ© â€” nÃ©cessaire pour construire le
# callback_url envoyÃ© aux prestataires de paiement externes (PayDunya...).
# Sur Vercel, laissez vide : VERCEL_PROJECT_PRODUCTION_URL est injectÃ© automatiquement.
