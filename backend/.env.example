# Active le mode dÃ©mo (paiements simulÃ©s, aucune vraie transaction) quand aucun prestataire n'est branchÃ©
PAYMENTS_DEMO_MODE=true

# --- WhatsApp (API Meta WhatsApp Cloud, intÃ©gration directe) pour les rappels de loyer, en complÃ©ment de l'email ---
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Tant que ces 2 valeurs ne sont pas renseignÃ©es, l'envoi retombe sur une
# simulation (comme l'email quand SMTP n'est pas configurÃ©) : aucun message rÃ©el n'est envoyÃ©.
# Jeton d'accÃ¨s permanent d'un "System User" (Meta Business Manager â†’ Business
# Settings â†’ System Users â†’ gÃ©nÃ©rer un jeton avec la permission
