# --- Connexion avec Google (gestionnaires uniquement) ---
# Client ID OAuth 2.0 crÃ©Ã© dans la Google Cloud Console (type "Application
# Web", identifiant se terminant par .apps.googleusercontent.com). Aucun
# Client Secret requis : la vÃ©rification du jeton Google se fait uniquement
# avec ce Client ID (voir auth.controller.ts::loginWithGoogle). Laissez vide
# pour dÃ©sactiver la route et masquer le bouton cÃ´tÃ© frontend (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# --- Email (SMTP Gmail) pour les rappels automatiques de fin de contrat ---
# 1. Activez la validation en 2 Ã©tapes sur le compte Gmail
# 2. GÃ©nÃ©rez un "mot de passe d'application" sur https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre-adresse@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM="Gestion ImmobiliÃ¨re <votre-adresse@gmail.com>"

# Nombre de jours avant la fin du contrat pour envoyer le rappel
CONTRACT_REMINDER_DAYS=14

# --- TÃ¢che planifiÃ©e (rappels de fin de contrat) ---
# En local (npm run dev) : un scheduler node-cron interne tourne automatiquement.
# Expression cron utilisÃ©e par ce scheduler local uniquement (par dÃ©faut: tous les jours Ã  8h00).
REMINDER_CRON="0 8 * * *"
# Mettez Ã  "false" en production sur Vercel : c'est le Vercel Cron Job (voir vercel.json)
# qui appelle /api/cron/contract-reminders Ã  la place d'un processus interne permanent.
ENABLE_INTERNAL_CRON=true
# Doit Ãªtre identique Ã  la variable d'environnement CRON_SECRET dÃ©finie sur le projet Vercel
# (Vercel l'envoie automatiquement en en-tÃªte Authorization lors de l'appel du Cron Job).
CRON_SECRET=

# --- Paiements ---
